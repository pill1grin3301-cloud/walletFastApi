# App
SECRET_KEY="your-secret-key-here"
ALGORITHM="HS256"
TELEGRAM_TOKEN="your-telegram-bot-token"
ADMIN_TELEGRAM_CHAT_ID=123456789

# PostgreSQL (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wallet
TEST_POSTGRES_DB=test_db

# App DB connection (hostname wallet_db — имя сервиса в docker-compose)
DATABASE_URL=postgresql+psycopg://postgres:change-me@wallet_db:5432/wallet

# Alembic с хоста (вне docker): раскомментируй и подставь пароль из POSTGRES_PASSWORD
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/wallet

# Tests (hostname test_db — имя сервиса test_db в docker-compose)
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@test_db:5432/test_db
